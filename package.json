{
  "name": "core-kernel",
  "version": "0.3.0",
  "description": "Blocos base de DDD/Clean Architecture (Result, Entity, ValueObject, UseCase, ports) para Bun e Node",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "result",
    "entity",
    "value-object",
    "use-case"
  ],
  "license": "MIT",
  "author": "macndesign <macndesign@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macndesign/core-kernel.git"
  },
  "homepage": "https://github.com/macndesign/core-kernel#readme",
  "bugs": {
    "url": "https://github.com/macndesign/core-kernel/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    ".claude-plugin/plugin.json",
    "hooks/hooks.json",
    "hooks/*.mjs",
    "agents",
    "skills",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "workspaces": [
    ".",
    "packages/*"
  ],
  "bin": {
    "core-kernel": "./dist/cli/index.js"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./vo": {
      "import": {
        "types": "./dist/esm/vo/index.d.ts",
        "default": "./dist/esm/vo/index.js"
      },
      "require": {
        "types": "./dist/cjs/vo/index.d.ts",
        "default": "./dist/cjs/vo/index.js"
      }
    },
    "./vo/br": {
      "import": {
        "types": "./dist/esm/vo/br/index.d.ts",
        "default": "./dist/esm/vo/br/index.js"
      },
      "require": {
        "types": "./dist/cjs/vo/br/index.d.ts",
        "default": "./dist/cjs/vo/br/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing/index.d.ts",
        "default": "./dist/esm/testing/index.js"
      },
      "require": {
        "types": "./dist/cjs/testing/index.d.ts",
        "default": "./dist/cjs/testing/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test ./src ./cli ./hooks",
    "test:coverage": "bun test --coverage ./src ./cli ./hooks",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:package": "publint --strict && attw --pack . --profile node16 && node scripts/smoke.mjs && node scripts/smoke.cjs && node scripts/smoke-cli.mjs && node scripts/sync-plugin-version.mjs --check",
    "verify": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run check:package && bun run check:plugin && bun run check:examples && bun run check:checker && bun run check:skills",
    "prepublishOnly": "bun run verify",
    "prepare": "node scripts/prepare.mjs",
    "check:examples": "tsc -p examples/tsconfig.json && bun test ./examples",
    "check:ts-compat": "bunx -p typescript@5.4.5 tsc -p examples/tsconfig.json",
    "check:skills": "bun scripts/check-skills.ts",
    "check:checker": "bun run --cwd packages/check verify",
    "check:plugin": "node scripts/validate-plugin.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-plugin-version.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
