{
  "name": "core-kernel",
  "version": "0.0.0",
  "description": "Blocos base de DDD/Clean Architecture (Result, Entity, ValueObject, UseCase, ports) para Bun e Node",
  "keywords": [
    "ddd",
    "domain-driven-design",
    "clean-architecture",
    "result",
    "entity",
    "value-object",
    "use-case"
  ],
  "license": "MIT",
  "author": "macndesign <macndesign@gmail.com>",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./vo": {
      "import": {
        "types": "./dist/esm/vo/index.d.ts",
        "default": "./dist/esm/vo/index.js"
      },
      "require": {
        "types": "./dist/cjs/vo/index.d.ts",
        "default": "./dist/cjs/vo/index.js"
      }
    },
    "./vo/br": {
      "import": {
        "types": "./dist/esm/vo/br/index.d.ts",
        "default": "./dist/esm/vo/br/index.js"
      },
      "require": {
        "types": "./dist/cjs/vo/br/index.d.ts",
        "default": "./dist/cjs/vo/br/index.js"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/esm/testing/index.d.ts",
        "default": "./dist/esm/testing/index.js"
      },
      "require": {
        "types": "./dist/cjs/testing/index.d.ts",
        "default": "./dist/cjs/testing/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:package": "publint --strict && attw --pack . --profile node16 && node scripts/smoke.mjs && node scripts/smoke.cjs",
    "verify": "bun run lint && bun run typecheck && bun run test:coverage && bun run build && bun run check:package",
    "prepublishOnly": "bun run verify",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "@types/node": "^20",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
